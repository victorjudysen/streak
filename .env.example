# Copy to .env.local for local development. On Netlify, add the same
# names under Project → Settings → Environment Variables.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Supabase dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Public key. Used only by the browser to listen for "tasks changed" signals (live
# updates). It cannot read or write any tasks — Row Level Security blocks it.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SECRET — server only, never share or commit. Starts with sb_secret_
SUPABASE_SECRET_KEY=

# ── App login ────────────────────────────────────────────────────────────────
# The password you type to open Streak. Use a long one; the site is on the internet.
APP_PASSWORD=
# Random string that signs the login cookie. Generate: openssl rand -hex 32
SESSION_SECRET=
# Your time zone (IANA name, e.g. Africa/Nairobi, Europe/London, America/New_York).
# Decides when "today" starts and ends, and when the morning message is sent.
STREAK_TIMEZONE=UTC
# Optional: your name, shown as initials in the header (e.g. "Ada Lovelace" → AL).
OWNER_NAME=

# ── Telegram bot ─────────────────────────────────────────────────────────────
# From @BotFather after /newbot
TELEGRAM_BOT_TOKEN=
# Random string Telegram sends with every message so the app knows it is really
# Telegram. Letters, digits, _ and - only. Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Your personal chat id. Leave empty at first — the bot replies with it on /start.
TELEGRAM_ALLOWED_CHAT_ID=
# Public https address of the deployed app, used by `npm run telegram:setup`.
APP_URL=https://your-streak.netlify.app

# ── Daily digest ─────────────────────────────────────────────────────────────
# Random string that lets the hourly scheduled function call /api/cron/daily-digest.
# Generate: openssl rand -hex 32
CRON_SECRET=
# Local hour (0–23) for the morning message. Default 9.
DIGEST_HOUR=9

# ── Source code (AGPL) ───────────────────────────────────────────────────────
# If you run a modified copy for other people, point this at your fork's source.
SOURCE_CODE_URL=
